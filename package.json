{
  "name": "medicron-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/api",
    "build": "npm run build -w apps/api",
    "lint": "npm run lint -w apps/api",
    "test": "npm test --workspaces --if-present",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  }
}
