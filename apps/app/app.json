{
  "expo": {
    "name": "Medicron",
    "slug": "medicron",
    "scheme": "medicron",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.medicron",
      "supportsTablet": false
    },
    "android": {
      "package": "app.medicron"
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ]
  }
}
