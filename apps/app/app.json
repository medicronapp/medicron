{
  "expo": {
    "name": "Medicron",
    "slug": "medicron",
    "scheme": "medicron",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.medicron",
      "supportsTablet": false,
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:medicron.com.br"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.medicron",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#0f766e"
      },
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "medicron.com.br",
              "pathPrefix": "/convite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0f766e",
          "dark": {
            "backgroundColor": "#0b3f3b"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0f766e"
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "MedicronWidget",
              "displayName": "Medicron",
              "description": "Anel do dia, próximas doses e pendentes",
              "ios": {
                "supportedFamilies": [
                  "systemMedium"
                ],
                "initialLayout": "./src/widgets/medicron-widget.tsx"
              }
            },
            {
              "name": "MedicronAgoraWidget",
              "displayName": "Medicron · Agora",
              "description": "A próxima dose e as pendentes, em três linhas",
              "ios": {
                "supportedFamilies": [
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "./src/widgets/medicron-agora-widget.tsx"
              }
            },
            {
              "name": "MedicronProgressoWidget",
              "displayName": "Medicron · Progresso",
              "description": "Anel do dia, pendentes e a próxima dose",
              "ios": {
                "supportedFamilies": [
                  "accessoryRectangular"
                ],
                "initialLayout": "./src/widgets/medicron-progresso-widget.tsx"
              }
            }
          ]
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "owner": "thiagog3",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f93d61ca-6621-4d98-a5e1-2e1667b557d6"
      }
    }
  }
}
