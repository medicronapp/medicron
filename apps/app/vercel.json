{
  "buildCommand": "node scripts/build-site.cli.ts && npx expo export -p web && node scripts/finalize-web.cli.ts",
  "outputDirectory": "dist",
  "installCommand": "cd ../.. && npm ci",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/gatos",
      "destination": "/pacientes",
      "permanent": true
    },
    {
      "source": "/gatos/:path*",
      "destination": "/pacientes/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/landing",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/landing/",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://medicron.vercel.app/api/:path*"
    },
    {
      "source": "/privacidade",
      "destination": "https://medicron.vercel.app/privacidade"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "https://medicron.vercel.app/.well-known/:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "source",
          "value": "pwa"
        }
      ],
      "destination": "/app.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "__Secure-better-auth.session_token"
        }
      ],
      "destination": "/app.html"
    },
    {
      "source": "/",
      "destination": "/landing/index.html"
    },
    {
      "source": "/((?!.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/landing/fonts/:file",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
